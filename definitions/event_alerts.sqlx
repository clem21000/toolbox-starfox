config {
  type: "view", // Creates a view in BigQuery. Try changing to "table" instead.
  columns: {
    test: "A descriptions for the test column", // Column descriptions are pushed to BigQuery.
  }
}


-- ⚙️ Paramètres
DECLARE start_date STRING DEFAULT "20260105";
DECLARE end_date   STRING DEFAULT "20260122";

-- 🧮 Durée d'analyse et Calcul dynamique de la baseline (×2, min 14j, max 90j)
DECLARE baseline_days INT64;
DECLARE period_length INT64;
SET period_length = DATE_DIFF(PARSE_DATE("%Y%m%d", end_date), PARSE_DATE("%Y%m%d", start_date), DAY) + 1;
SET baseline_days = LEAST(GREATEST(period_length * 2, 14), 90);

-- 🧭 Période de comparaison dynamique
WITH period AS (
  SELECT
    start_date AS current_start,
    end_date   AS current_end,
    FORMAT_DATE(
      "%Y%m%d",
      DATE_SUB(PARSE_DATE("%Y%m%d", start_date), INTERVAL baseline_days DAY)
    ) AS baseline_start,
    FORMAT_DATE("%Y%m%d", DATE_SUB(PARSE_DATE("%Y%m%d", start_date), INTERVAL 1 DAY)) AS baseline_end,
    FORMAT_DATE(
      "%Y%m%d",
      DATE_SUB(PARSE_DATE("%Y%m%d", start_date),
        INTERVAL (DATE_DIFF(PARSE_DATE("%Y%m%d", end_date), PARSE_DATE("%Y%m%d", start_date), DAY) + 1) DAY)
    ) AS prev_start,
    FORMAT_DATE("%Y%m%d", DATE_SUB(PARSE_DATE("%Y%m%d", start_date), INTERVAL 1 DAY)) AS prev_end
)

-- ======================
-- 📦 Données : 1 ligne = 1 événement
-- ======================
, base_events AS (
  SELECT
    event_name,
    user_pseudo_id,
    _TABLE_SUFFIX AS table_date
  FROM `annular-bucksaw-109316.analytics_502722504.events_*`
  WHERE _TABLE_SUFFIX BETWEEN (SELECT current_start FROM period) AND (SELECT current_end FROM period)
),
base_events_prev AS (
  SELECT
    event_name,
    user_pseudo_id,
    _TABLE_SUFFIX AS table_date
  FROM `annular-bucksaw-109316.analytics_502722504.events_*`
  WHERE _TABLE_SUFFIX BETWEEN (SELECT prev_start FROM period) AND (SELECT prev_end FROM period)
),
base_events_baseline AS (
  SELECT
    event_name,
    _TABLE_SUFFIX AS table_date
  FROM `annular-bucksaw-109316.analytics_502722504.events_*`
  WHERE _TABLE_SUFFIX BETWEEN (SELECT baseline_start FROM period) AND (SELECT baseline_end FROM period)
)

-- ======================
-- 📈 Comptages agrégés
-- ======================
, event_stats AS (
  SELECT event_name, COUNT(*) AS event_count
  FROM base_events
  GROUP BY event_name
),
event_stats_prev AS (
  SELECT event_name, COUNT(*) AS event_count_prev
  FROM base_events_prev
  GROUP BY event_name
),
event_stats_baseline AS (
  SELECT event_name, table_date, COUNT(*) AS event_count
  FROM base_events_baseline
  GROUP BY event_name, table_date
),
event_stats_avg_baseline AS (
  SELECT
    event_name,
    ROUND(AVG(event_count),0) AS event_count_avg_baseline
  FROM (
    SELECT event_name, event_count,
           PERCENT_RANK() OVER (PARTITION BY event_name ORDER BY event_count) AS rnk
    FROM event_stats_baseline
  )
  WHERE rnk BETWEEN 0.1 AND 0.9
  GROUP BY event_name
)

-- ======================
-- 🧩 Assemblage final + pondération de confiance + double alerte
-- ======================
SELECT
  -- 📅 Ajout des dimensions temporelles
  CONCAT((SELECT current_start FROM period), ' - ', (SELECT current_end FROM period)) AS period,
  CONCAT((SELECT prev_start FROM period), ' - ', (SELECT prev_end FROM period)) AS period_prev,
  CONCAT((SELECT baseline_start FROM period), ' - ', (SELECT baseline_end FROM period)) AS period_avg,

  -- 📊 Données analytiques
  e.event_name,
  e.event_count,
  e_prev.event_count_prev,
  e_avg.event_count_avg_baseline,

  -- 🔸 Variations
  ROUND(((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*100,2) AS delta_event_pct,
  ROUND(((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*100,2) AS delta_event_avg,

  -- 🔸 Confiance et pondération
  CASE
    WHEN e.event_count < 100 THEN '⚪ Très faible'
    WHEN e.event_count < 1000 THEN '🟡 Moyenne'
    WHEN e.event_count < 10000 THEN '🟢 Forte'
    ELSE '🔵 Très forte'
  END AS confidence_level,

  ROUND(((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1),2) AS weighted_delta_prev,
  ROUND(((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1),2) AS weighted_delta_avg,

  -- 🔹 Alertes pondérées
  CASE
    WHEN e.event_count < 100 THEN '⚪ Données insuffisantes'
    WHEN ((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1) <= -15 THEN '🔴 Critique'
    WHEN ((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1) <= -5 THEN '🟠 Attention'
    WHEN ((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1) BETWEEN -5 AND 5 THEN '🟢 Stable'
    WHEN ((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1) > 5 THEN '🔵 Amélioration'
  END AS weighted_alert_prev,

  CASE
    WHEN e.event_count < 100 THEN '⚪ Données insuffisantes'
    WHEN ((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1) <= -15 THEN '🔴 Critique'
    WHEN ((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1) <= -5 THEN '🟠 Attention'
    WHEN ((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1) BETWEEN -5 AND 5 THEN '🟢 Stable'
    WHEN ((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1) > 5 THEN '🔵 Amélioration'
  END AS weighted_alert_avg,

  -- 🔹 Synthèse globale (plus sévère des deux)
  CASE
    WHEN e.event_count < 100 THEN '⚪ Données insuffisantes'
    WHEN (
      ((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1) <= -15
      OR ((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1) <= -15
    ) THEN '🔴 Critique'
    WHEN (
      ((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1) <= -5
      OR ((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1) <= -5
    ) THEN '🟠 Attention'
    WHEN (
      ((e.event_count - e_prev.event_count_prev)/e_prev.event_count_prev)*LOG10(e.event_count + 1) BETWEEN -5 AND 5
      AND ((e.event_count - e_avg.event_count_avg_baseline)/e_avg.event_count_avg_baseline)*LOG10(e.event_count + 1) BETWEEN -5 AND 5
    ) THEN '🟢 Stable'
    ELSE '🔵 Amélioration'
  END AS global_alert_level

FROM event_stats e
LEFT JOIN event_stats_prev  e_prev USING(event_name)
LEFT JOIN event_stats_avg_baseline e_avg USING(event_name)
ORDER BY e.event_name